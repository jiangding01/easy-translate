{
  "name": "easy-translate",
  "description": "网页翻译 Chrome 扩展",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "wxt --browser chrome",
    "build": "wxt build --browser chrome",
    "zip": "wxt zip --browser chrome",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && node scripts/check-build.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "wxt": "^0.21.5"
  }
}
