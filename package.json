{
  "name": "easy-translate",
  "description": "网页翻译 Chrome 扩展",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wxt --browser chrome",
    "build": "wxt build --browser chrome",
    "zip": "wxt zip --browser chrome",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:build": "node scripts/check-build.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:contrast && npm run test && npm run build && npm run check:build && npm run check:size",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.1",
    "idb": "^8.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^20.14.6",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  }
}
